[Unit]
Description=factory-service service
Requires=dbus.service
After=dbus.service
DefaultDependencies=no

[Service]
Type=simple
Environment=LD_USE_LOAD_BIAS=1
ExecStart=/usr/bin/TIFSDaemon
Restart=always

[Install]
WantedBy=sysinit.target
