[Unit]
Description=Start the TV service daemon
DefaultDependencies=no

[Service]
Type=forking
OOMScoreAdjust=-900
ExecStart=/usr/bin/tvs-daemon.sh
PIDFile=/tmp/.tvs-daemon.pid
Restart=on-failure
RestartSec=1

[Install]
Alias=tvs_deamon.service
 
